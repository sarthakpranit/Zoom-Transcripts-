{
  "manifest_version": 3,
  "name": "Zoom Transcript Saver",
  "version": "1.0.0",
  "description": "Automatically captures Zoom web meeting transcripts and saves them as .txt files to ~/Downloads/Zoom Transcripts/.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.zoom.us/*",
    "https://zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zoom.us/wc/*",
        "https://zoom.us/wc/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
